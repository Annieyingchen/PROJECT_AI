# 复制本文件为 .env，填入真实配置即可运行
# 任选一家「OpenAI 兼容接口」，改下面三行即可切换

# ---- 必填 ----
# 通义千问（推荐，国内直连）
QA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QA_LLM_API_KEY=sk-你的key
QA_LLM_MODEL=qwen-plus

# DeepSeek 示例：
# QA_LLM_BASE_URL=https://api.deepseek.com
# QA_LLM_API_KEY=sk-你的key
# QA_LLM_MODEL=deepseek-chat

# 豆包（火山方舟）示例：
# QA_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# QA_LLM_API_KEY=你的key
# QA_LLM_MODEL=你的接入点ID

# ---- 可选 ----
QA_SYSTEM_PROMPT=你是一个乐于助人的问答助手，回答简洁、准确。
QA_MAX_TURNS=6
QA_TEMPERATURE=0.7
